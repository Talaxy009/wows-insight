    "ratingScale.footer" : {
      "comment" : "Footer of the rating explanation sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal rating comes from the Yuyuko API, which applies the wows-numbers formula to per-server expectations: 700 × damage + 300 × kills + 150 × win rate. For reference only."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個人レーティングは Yuyuko API が提供しており、サーバーごとの期待値に wows-numbers の式（700 × ダメージ + 300 × 撃沈数 + 150 × 勝率）を当てはめた値です。参考情報です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인 평가는 Yuyuko API에서 제공하며, 서버별 기대값에 wows-numbers 공식(700 × 피해량 + 300 × 격침 수 + 150 × 승률)을 적용한 값입니다. 참고용입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "个人评分由 Yuyuko API 提供，按各服务器单独的期望值套用 wows-numbers 公式：700 × 伤害 + 300 × 击杀 + 150 × 胜率之和。数据仅供参考。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個人評分由 Yuyuko API 提供，按各伺服器單獨的期望值套用 wows-numbers 公式：700 × 傷害 + 300 × 擊殺 + 150 × 勝率之和。資料僅供參考。"
          }
        }
      }
    },
